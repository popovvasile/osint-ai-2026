    {
      "parameters": {
        "jsCode": "const htmlContent = $input.first().json.output;\nconst overallRisk = $('Aggregate Results').first().json.overallRisk;\nconst entityCount = $('Aggregate Results').first().json.entityCount;\n\nconst slug = 'report-' + new Date().toISOString().split('T')[0] + '-' + Math.random().toString(36).substr(2, 6);\n\n// Convert HTML to base64 for GitHub API\nconst base64Content = Buffer.from(htmlContent, 'utf-8').toString('base64');\n\nreturn [{\n  json: {\n    slug,\n    htmlContent,\n    base64Content,\n    overallRisk,\n    entityCount\n  }\n}];\n"
      },
